---
import PressCard from '../../components/PressCard.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getEditorialPlatforms, getPressCoverage } from '../../lib/content';
import { breadcrumbStructuredData } from '../../lib/seo';

const press = await getPressCoverage();
const platforms = await getEditorialPlatforms();
---

<SiteLayout
  title="Prensa"
  description="Apariciones en prensa, entrevistas, cobertura cultural y referencias editoriales sobre la obra de Jorge Morcillo Jareño."
  image="/assets/img/prensa/jorge-morcillo-prensa.webp"
  imageAlt="Retrato editorial de Jorge Morcillo Jareño en una librería"
  imageWidth={1672}
  imageHeight={941}
  structuredData={breadcrumbStructuredData([
    { name: 'Inicio', path: '/' },
    { name: 'Prensa', path: '/prensa/' }
  ])}
>
  <header class="section-hero section-hero--media">
    <div class="section-hero__copy">
      <p class="section-kicker">Archivo</p>
      <h1>Prensa</h1>
      <p class="section-hero__lead">
        Apariciones en medios, entrevistas y cobertura periodística sobre Jorge Morcillo Jareño y su obra. Las fichas editoriales, plataformas y recepción de lectores se recogen aparte para no mezclarlas con la cobertura periodística.
      </p>
    </div>

    <figure class="section-hero__image">
      <img
        src="/assets/img/prensa/jorge-morcillo-prensa.webp"
        width="1672"
        height="941"
        alt="Retrato editorial de Jorge Morcillo Jareño en una librería, con estanterías desenfocadas al fondo."
        loading="eager"
        decoding="async"
      />
    </figure>
  </header>

  {press.length > 0 && (
    <section class="press-archive-section" aria-labelledby="press-coverage-title">
      <div class="press-archive-section__heading">
        <div>
          <p class="section-kicker">Cobertura</p>
          <h2 id="press-coverage-title">Prensa y entrevistas</h2>
        </div>
        <p>Noticias, perfiles, entrevistas y artículos sobre los libros y la trayectoria pública del autor.</p>
      </div>

      <div class="press-grid press-grid--archive">
        {press.map((item) => <PressCard item={item} />)}
      </div>
    </section>
  )}

  {platforms.length > 0 && (
    <section class="press-archive-section press-archive-section--secondary" aria-labelledby="press-platforms-title">
      <div class="press-archive-section__heading">
        <div>
          <p class="section-kicker">Referencias</p>
          <h2 id="press-platforms-title">Editoriales, librerías y recepción</h2>
        </div>
        <p>Fichas oficiales de los libros, presencia en plataformas y reseñas o valoraciones de lectores.</p>
      </div>

      <div class="press-grid press-grid--resources">
        {platforms.map((item) => <PressCard item={item} compact />)}
      </div>
    </section>
  )}
</SiteLayout>
