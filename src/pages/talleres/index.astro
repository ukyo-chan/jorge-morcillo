---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { breadcrumbStructuredData } from '../../lib/seo';
import { site } from '../../lib/site';

interface Workshop {
  number: string;
  title: string;
  meta: string;
  description: string;
  duration: string;
  development: string;
  objective: string;
  bookHref?: string;
  bookLabel?: string;
  referenceHref?: string;
  referenceLabel?: string;
}

const workshops: Workshop[] = [
  {
    number: '01',
    title: 'Encuentro con el autor',
    meta: 'Animación lectora · tertulia literaria',
    description:
      'Una tertulia literaria en torno a cualquiera de los libros publicados por Jorge Morcillo, pensada para acercar al lector al autor y a la historia desde una conversación directa y participativa.',
    duration: '50 minutos',
    development:
      'La sesión parte del libro elegido y combina una breve presentación, conversación guiada sobre la historia, sus personajes y temas, comentarios sobre el proceso de escritura y un espacio amplio para las preguntas de los lectores.',
    objective:
      'Fomentar el gusto por la lectura y la participación oral, despertar la curiosidad por el proceso creativo y convertir el encuentro con un autor en una experiencia cercana que prolongue la lectura más allá del libro.',
    bookHref: '/#libros',
    bookLabel: 'Ver libros publicados'
  },
  {
    number: '02',
    title: 'Cuentos valencianos: lectura y mural',
    meta: 'Literatura · cultura valenciana · creación plástica',
    description:
      'Taller literario y creativo a partir de Cuentos valencianos para compartir, en el que lectura, cultura valenciana e imaginación se unen a una actividad plástica colectiva.',
    duration: '50 minutos',
    development:
      'Jorge introduce brevemente el relato escogido y realiza una lectura de un fragmento. A partir de sus personajes, lugares e ideas, el grupo desarrolla una propuesta visual y participa en la creación y pintura de un mural inspirado en el cuento.',
    objective:
      'Acercar la literatura y la cultura valenciana a través de una experiencia creativa, favorecer la comprensión y reinterpretación del texto mediante imágenes y promover la expresión plástica y el trabajo compartido.',
    bookHref: '/libros/cuentos-valencianos-para-compartir/',
    bookLabel: 'Ver Cuentos valencianos para compartir'
  },
  {
    number: '03',
    title: 'Cultura millennial y tecnología vintage',
    meta: 'Literatura juvenil · cultura millennial · tecnología',
    description:
      'Un recorrido participativo por la cultura millennial a partir de Mi padre es un Millennial y del contacto directo con objetos tecnológicos anteriores al smartphone.',
    duration: '50 minutos',
    development:
      'La actividad alterna la lectura de fragmentos de la novela con la observación y manipulación de tecnología vintage, como un Discman o una consola de 16 bits. A partir de estos objetos se conversa sobre videojuegos, música, comunicación, ocio y vida cotidiana, comparando la experiencia millennial con la de los jóvenes actuales.',
    objective:
      'Comprender cómo han cambiado la tecnología y los hábitos cotidianos en pocas décadas, favorecer el diálogo entre generaciones y utilizar la literatura como punto de partida para reflexionar sobre nuestra relación con la tecnología.',
    bookHref: '/libros/mi-padre-es-un-millennial/',
    bookLabel: 'Ver Mi padre es un Millennial'
  },
  {
    number: '04',
    title: 'Taller de periodismo para Secundaria',
    meta: 'Secundaria · 1 mes · 2 h semanales',
    description:
      'Programa práctico de iniciación al periodismo dirigido a los dos primeros ciclos de Secundaria, centrado en conocer los principales textos periodísticos y aprender especialmente a redactar una noticia.',
    duration: '1 mes · 2 horas semanales',
    development:
      'A lo largo de las sesiones se trabajan las principales tipologías textuales periodísticas mediante explicación, ejemplos y ejercicios prácticos. El alumnado aprende a seleccionar la información relevante, organizar los datos, construir un titular y redactar y revisar una noticia con claridad. El planteamiento conecta con la experiencia de Periodistas Junior, proyecto diseñado por Jorge Morcillo en el que estudiantes trabajaron como una pequeña redacción periodística.',
    objective:
      'Conocer las características básicas de los textos periodísticos y adquirir herramientas para interpretar y producir información, con especial atención a la estructura, la selección de datos y la redacción clara y rigurosa de una noticia.',
    referenceHref: 'https://www.elperiodic.com/alboraya/escolares-entrevistan-concejal-manuel-duenas_276770',
    referenceLabel: 'Ver la experiencia «Periodistas Junior» en El Periodic'
  }
];

const workshopMailto = (title: string) =>
  `mailto:${site.contactEmail}?subject=${encodeURIComponent(`Consulta sobre taller: ${title}`)}`;
---

<SiteLayout
  title="Talleres literarios y educativos"
  description="Talleres literarios y educativos de Jorge Morcillo para centros, bibliotecas y espacios culturales: encuentros con autor, lectura, cultura millennial y periodismo."
  image="/assets/img/talleres/jorge-morcillo-talleres.webp"
  imageAlt="Retrato de Jorge Morcillo Jareño en un aula"
  imageWidth={1672}
  imageHeight={941}
  structuredData={breadcrumbStructuredData([
    { name: 'Inicio', path: '/' },
    { name: 'Talleres', path: '/talleres/' }
  ])}
>
  <header class="section-hero section-hero--media">
    <div class="section-hero__copy">
      <p class="section-kicker">Literatura · cultura · aula</p>
      <h1>Talleres</h1>
      <p class="section-hero__lead">
        Talleres literarios y educativos para centros escolares, bibliotecas, clubes de lectura y espacios culturales. Jorge Morcillo propone actividades participativas que conectan los libros con la cultura valenciana, la memoria generacional, la creatividad y el periodismo.
      </p>
      <div class="section-hero__actions">
        <a class="button-link button-link--primary" href={`mailto:${site.contactEmail}?subject=${encodeURIComponent('Consulta sobre talleres')}`}>
          Consultar disponibilidad
        </a>
      </div>
    </div>

    <figure class="section-hero__image">
      <img
        src="/assets/img/talleres/jorge-morcillo-talleres.webp"
        width="1672"
        height="941"
        alt="Retrato de Jorge Morcillo Jareño en un aula luminosa, con pupitres desenfocados al fondo."
        loading="eager"
        decoding="async"
      />
    </figure>
  </header>

  <section class="workshops-list" aria-label="Talleres literarios y educativos disponibles">
    {workshops.map((workshop) => (
      <article class="workshop-card">
        <div class="workshop-card__index" aria-hidden="true">{workshop.number}</div>

        <div class="workshop-card__content">
          <p class="workshop-card__meta">{workshop.meta}</p>
          <h2>{workshop.title}</h2>
          <p class="workshop-card__description">{workshop.description}</p>

          <div class="workshop-card__duration">
            <span>Duración</span>
            <strong>{workshop.duration}</strong>
          </div>

          <div class="workshop-card__details">
            <section>
              <h3>Desarrollo</h3>
              <p>{workshop.development}</p>
            </section>
            <section>
              <h3>Objetivo</h3>
              <p>{workshop.objective}</p>
            </section>
          </div>

          {workshop.bookHref && workshop.bookLabel && (
            <a class="text-link workshop-card__book" href={workshop.bookHref}>
              {workshop.bookLabel} <span aria-hidden="true">→</span>
            </a>
          )}

          {workshop.referenceHref && workshop.referenceLabel && (
            <a
              class="text-link workshop-card__book"
              href={workshop.referenceHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              {workshop.referenceLabel} <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>

        <div class="workshop-card__action">
          <a class="button-link" href={workshopMailto(workshop.title)}>
            Solicitar este taller
          </a>
        </div>
      </article>
    ))}
  </section>

  <section class="workshops-contact" aria-labelledby="workshops-contact-title">
    <div>
      <p class="section-kicker">Contratación</p>
      <h2 id="workshops-contact-title">Organiza un taller</h2>
    </div>
    <div class="workshops-contact__copy">
      <p>
        Las propuestas pueden plantearse para centros educativos, bibliotecas, clubes de lectura, librerías y otras entidades culturales. Escribe indicando el taller que te interesa y desde dónde contactas para consultar disponibilidad y concretar la actividad.
      </p>
      <a class="button-link button-link--primary" href={`mailto:${site.contactEmail}?subject=${encodeURIComponent('Consulta sobre talleres')}`}>
        Escribir a Jorge
      </a>
    </div>
  </section>
</SiteLayout>
