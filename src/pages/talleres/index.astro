---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { breadcrumbStructuredData } from '../../lib/seo';
import { site } from '../../lib/site';

interface Workshop {
  number: string;
  title: string;
  meta: string;
  description: string;
  bookHref?: string;
  bookLabel?: string;
}

const workshops: Workshop[] = [
  {
    number: '01',
    title: 'Encuentro con el autor',
    meta: 'Literatura · tertulia',
    description:
      'Una tertulia literaria en torno a cualquiera de los libros publicados por Jorge Morcillo. Un espacio para conversar sobre la obra elegida y compartir preguntas e impresiones con el autor.',
    bookHref: '/#libros',
    bookLabel: 'Ver libros publicados'
  },
  {
    number: '02',
    title: 'Cuentos valencianos: lectura y mural',
    meta: 'Lectura · creación plástica',
    description:
      'Una breve lectura de Cuentos valencianos para compartir acompañada de una actividad plástica en grupo: pintar murales inspirados en el cuento trabajado.',
    bookHref: '/libros/cuentos-valencianos-para-compartir/',
    bookLabel: 'Ver Cuentos valencianos para compartir'
  },
  {
    number: '03',
    title: 'Cultura millennial y tecnología vintage',
    meta: 'Literatura · memoria tecnológica',
    description:
      'Varios fragmentos de Mi padre es un Millennial sirven como punto de partida para conocer la cultura millennial y manipular elementos tecnológicos vintage, como un Discman o una consola de 16 bits.',
    bookHref: '/libros/mi-padre-es-un-millennial/',
    bookLabel: 'Ver Mi padre es un Millennial'
  },
  {
    number: '04',
    title: 'Taller de periodismo',
    meta: 'Secundaria · 1 mes · 2 h semanales',
    description:
      'Dirigido a los dos primeros ciclos de Secundaria. Durante un mes, con dos horas semanales, el alumnado conoce las principales tipologías textuales periodísticas y trabaja especialmente cómo redactar una noticia.'
  }
];

const workshopMailto = (title: string) =>
  `mailto:${site.contactEmail}?subject=${encodeURIComponent(`Consulta sobre taller: ${title}`)}`;
---

<SiteLayout
  title="Talleres"
  description="Talleres de Jorge Morcillo Jareño: encuentros con el autor, actividades a partir de sus libros y formación práctica en periodismo para Secundaria."
  image="/assets/img/talleres/jorge-morcillo-talleres.webp"
  imageAlt="Retrato de Jorge Morcillo Jareño en un aula"
  imageWidth={1672}
  imageHeight={941}
  structuredData={breadcrumbStructuredData([
    { name: 'Inicio', path: '/' },
    { name: 'Talleres', path: '/talleres/' }
  ])}
>
  <header class="section-hero section-hero--media">
    <div class="section-hero__copy">
      <p class="section-kicker">Literatura · cultura · aula</p>
      <h1>Talleres</h1>
      <p class="section-hero__lead">
        Propuestas para trabajar la lectura, la memoria cultural y el periodismo de forma participativa. Para consultar disponibilidad o plantear una actividad, puedes escribir directamente a Jorge.
      </p>
      <div class="section-hero__actions">
        <a class="button-link button-link--primary" href={`mailto:${site.contactEmail}?subject=${encodeURIComponent('Consulta sobre talleres')}`}>
          Consultar talleres
        </a>
      </div>
    </div>

    <figure class="section-hero__image">
      <img
        src="/assets/img/talleres/jorge-morcillo-talleres.webp"
        width="1672"
        height="941"
        alt="Retrato de Jorge Morcillo Jareño en un aula luminosa, con pupitres desenfocados al fondo."
        loading="eager"
        decoding="async"
      />
    </figure>
  </header>

  <section class="workshops-list" aria-label="Talleres disponibles">
    {workshops.map((workshop) => (
      <article class="workshop-card">
        <div class="workshop-card__index" aria-hidden="true">{workshop.number}</div>

        <div class="workshop-card__content">
          <p class="workshop-card__meta">{workshop.meta}</p>
          <h2>{workshop.title}</h2>
          <p class="workshop-card__description">{workshop.description}</p>

          {workshop.bookHref && workshop.bookLabel && (
            <a class="text-link workshop-card__book" href={workshop.bookHref}>
              {workshop.bookLabel} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>

        <div class="workshop-card__action">
          <a class="button-link" href={workshopMailto(workshop.title)}>
            Solicitar este taller
          </a>
        </div>
      </article>
    ))}
  </section>

  <section class="workshops-contact" aria-labelledby="workshops-contact-title">
    <div>
      <p class="section-kicker">Contratación</p>
      <h2 id="workshops-contact-title">¿Quieres organizar uno?</h2>
    </div>
    <div class="workshops-contact__copy">
      <p>
        Escribe indicando qué taller te interesa y desde dónde contactas para concretar la propuesta.
      </p>
      <a class="button-link button-link--primary" href={`mailto:${site.contactEmail}?subject=${encodeURIComponent('Consulta sobre talleres')}`}>
        Escribir a Jorge
      </a>
    </div>
  </section>
</SiteLayout>
