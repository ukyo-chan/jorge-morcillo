---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { breadcrumbStructuredData } from '../../lib/seo';
import { site } from '../../lib/site';

const mailto = `mailto:${site.contactEmail}`;
---

<SiteLayout
  title="Contacto"
  description="Contacto profesional con Jorge Morcillo Jareño para prensa, presentaciones, encuentros con lectores, centros educativos y propuestas relacionadas con su obra."
  structuredData={breadcrumbStructuredData([
    { name: 'Inicio', path: '/' },
    { name: 'Contacto', path: '/contacto/' }
  ])}
>
  <section class="contact-simple" aria-labelledby="contact-title">
    <div class="contact-simple__intro">
      <p class="section-kicker">Contacto profesional</p>
      <h1 id="contact-title">¿Hablamos?</h1>
      <p class="contact-simple__lead">
        Para prensa, presentaciones, encuentros con lectores, centros educativos, librerías y propuestas profesionales relacionadas con su obra.
      </p>
    </div>

    <figure class="contact-simple__portrait">
      <img
        src="/assets/img/contacto/telefono-rueda-contacto.webp"
        alt="Teléfono fijo antiguo de disco en verde jade con el auricular descolgado"
        width="1536"
        height="1024"
        loading="eager"
        decoding="async"
      />
    </figure>

    <div class="contact-simple__channels" aria-label="Canales de contacto">
      <div class="contact-simple__channel">
        <p class="contact-simple__label">Correo</p>
        <a class="contact-simple__email" href={mailto}>{site.contactEmail}</a>
        <a class="button-link button-link--primary" href={mailto}>Escribir a Jorge</a>
      </div>

      <div class="contact-simple__channel">
        <p class="contact-simple__label">Instagram</p>
        <a
          class="contact-simple__social"
          href={site.instagramUrl}
          target="_blank"
          rel="me noopener noreferrer"
        >
          {site.instagramHandle}
        </a>
        <a
          class="button-link"
          href={site.instagramUrl}
          target="_blank"
          rel="me noopener noreferrer"
        >
          Ver Instagram
        </a>
      </div>
    </div>
  </section>

  <nav class="contact-simple__links" aria-label="Seguir explorando">
    <a href="/#libros">Libros <span aria-hidden="true">→</span></a>
    <a href="/autor/">Sobre Jorge <span aria-hidden="true">→</span></a>
    <a href="/talleres/">Talleres <span aria-hidden="true">→</span></a>
    <a href="/prensa/">Prensa <span aria-hidden="true">→</span></a>
  </nav>
</SiteLayout>

<style>
  #contact-title {
    max-width: none;
    overflow-wrap: normal;
    word-break: normal;
    white-space: nowrap;
    font-size: clamp(4rem, 8vw, 7rem);
  }

  @media (max-width: 480px) {
    #contact-title {
      font-size: clamp(2.9rem, 15vw, 4.45rem);
    }
  }
</style>
