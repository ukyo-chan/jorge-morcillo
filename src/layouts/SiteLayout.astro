---
import SiteNavigation from '../components/SiteNavigation.astro';
import type { StructuredData } from '../lib/seo';
import { site } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article' | 'book';
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
  structuredData?: StructuredData | StructuredData[];
}

const {
  title,
  description,
  ogType = 'website',
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  noindex,
  structuredData
} = Astro.props;

const shouldNoindex = noindex ?? !site.indexingEnabled;
const pageTitle = title === site.name ? `${site.name} | Escritor valenciano` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
const socialImagePath = image ?? site.defaultSocialImage;
const socialImage = new URL(socialImagePath, Astro.site ?? site.url).toString();
const socialImageAlt = imageAlt ?? `Retrato editorial de ${site.name}`;
const currentYear = new Date().getFullYear();
const structuredDataItems = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const serializedStructuredData = structuredDataItems.map((item) =>
  JSON.stringify(item).replace(/</g, '\\u003c')
);
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={shouldNoindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#f5f1e8" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>

    {serializedStructuredData.map((json) => (
      <script type="application/ld+json" set:html={json}></script>
    ))}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href="/" aria-label={`${site.name}, inicio`}>
          <span class="site-brand__name">{site.name}</span>
          <span class="site-brand__descriptor">{site.shortDescriptor}</span>
        </a>
        <SiteNavigation />
      </div>
    </header>

    <main class="site-main" id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div>
          <p class="site-footer__name">{site.name}</p>
          <p class="site-footer__descriptor">{site.descriptor}</p>
        </div>
        <p class="site-footer__meta">© {currentYear}</p>
      </div>
    </footer>
  </body>
</html>
