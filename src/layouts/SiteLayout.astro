---
import SiteNavigation from '../components/SiteNavigation.astro';
import type { StructuredData } from '../lib/seo';
import { site } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article' | 'book';
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
  structuredData?: StructuredData | StructuredData[];
}

const {
  title,
  description,
  ogType = 'website',
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  noindex,
  structuredData
} = Astro.props;

const shouldNoindex = noindex ?? !site.indexingEnabled;
const pageTitle = title === site.name ? `${site.name} | Escritor valenciano` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
const socialImagePath = image ?? site.defaultSocialImage;
const socialImage = new URL(socialImagePath, Astro.site ?? site.url).toString();
const socialImageAlt = imageAlt ?? `Retrato editorial de ${site.name}`;
const currentYear = new Date().getFullYear();
const structuredDataItems = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const serializedStructuredData = structuredDataItems.map((item) =>
  JSON.stringify(item).replace(/</g, '\\u003c')
);
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={shouldNoindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#f5f1e8" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={site.faviconLight} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href={site.faviconDark} media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href={site.faviconLight} />
    <title>{pageTitle}</title>

    {serializedStructuredData.map((json) => (
      <script type="application/ld+json" set:html={json}></script>
    ))}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="site-header__inner">
        <div class="site-header__bar">
          <a class="site-brand" href="/" aria-label={`${site.name}, inicio`}>
            <img
              class="site-brand__mark"
              src={site.brandLogo}
              alt=""
              width="54"
              height="54"
              loading="eager"
              decoding="async"
            />
            <span class="site-brand__text">
              <span class="site-brand__name">{site.name}</span>
              <span class="site-brand__descriptor">{site.shortDescriptor}</span>
            </span>
          </a>
          <SiteNavigation />
        </div>
      </div>
    </header>

    <main class="site-main" id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p class="site-footer__name">{site.name}</p>
        <div class="site-footer__meta">
          <a
            class="site-footer__action"
            href={site.instagramUrl}
            target="_blank"
            rel="me noopener noreferrer"
            aria-label={`Instagram de ${site.name}: ${site.instagramHandle}`}
            title={`Instagram ${site.instagramHandle}`}
          >
            <img src="/assets/icons/instagram-circle.svg" alt="" width="36" height="36" loading="lazy" />
            <span class="visually-hidden">Instagram {site.instagramHandle}</span>
          </a>
          <a
            class="site-footer__action"
            href={`mailto:${site.contactEmail}`}
            aria-label={`Enviar un correo a ${site.name}`}
            title={`Escribir a ${site.contactEmail}`}
          >
            <img src="/assets/icons/mail-circle.svg" alt="" width="36" height="36" loading="lazy" />
            <span class="visually-hidden">Enviar correo a {site.contactEmail}</span>
          </a>
          <span class="site-footer__copyright">© {currentYear}</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header__bar {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-brand {
    min-width: 0;
    align-items: center;
    flex-direction: row;
    gap: 0.85rem;
  }

  .site-brand__mark {
    width: 54px;
    height: 54px;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .site-brand__text {
    display: inline-flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.15rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.45rem 1.65rem;
  }

  .site-footer__name {
    flex: 0 1 auto;
    min-width: 0;
    margin: 0;
    line-height: 1.1;
    white-space: nowrap;
  }

  .site-footer__meta {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: flex-end;
    gap: 0.42rem;
    margin-left: auto;
  }

  .site-footer__action {
    display: inline-grid;
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    place-items: center;
    border-radius: 50%;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .site-footer__action img {
    width: 30px;
    height: 30px;
  }

  .site-footer__action:hover {
    transform: translateY(-1px);
    box-shadow: 0 5px 14px rgba(31, 36, 33, 0.1);
  }

  .site-footer__copyright {
    margin-left: 0.28rem;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1;
    white-space: nowrap;
  }

  @media (max-width: 920px) {
    .site-header__inner {
      padding-block: 0.5rem;
    }

    .site-header__bar {
      min-height: 54px;
      gap: 0.65rem;
    }

    .site-brand {
      flex: 1 1 auto;
      gap: 0.65rem;
    }

    .site-brand__mark {
      width: 46px;
      height: 46px;
    }

    .site-brand__name {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  @media (max-width: 430px) {
    .site-brand__mark {
      width: 40px;
      height: 40px;
    }

    .site-brand__name {
      font-size: 0.98rem;
    }

    .site-footer__inner {
      justify-content: flex-end;
      gap: 0;
      padding-block: 1.3rem 1.45rem;
    }

    .site-footer__name {
      display: none;
    }

    .site-footer__meta {
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__action {
      transition: none;
    }
  }
</style>
