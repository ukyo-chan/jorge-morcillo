---
import SiteNavigation from '../components/SiteNavigation.astro';
import { site } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article' | 'book';
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  image,
  noindex
} = Astro.props;

const shouldNoindex = noindex ?? !site.indexingEnabled;

const pageTitle = title === site.name ? site.name : `${title} | ${site.name}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const socialImage = image && Astro.site ? new URL(image, Astro.site).toString() : undefined;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={shouldNoindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#f5f1e8" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}

    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    {canonical && <link rel="canonical" href={canonical} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href="/" aria-label={`${site.name}, inicio`}>
          <span class="site-brand__name">{site.name}</span>
          <span class="site-brand__descriptor">{site.shortDescriptor}</span>
        </a>
        <SiteNavigation />
      </div>
    </header>

    <main class="site-main" id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div>
          <p class="site-footer__name">{site.name}</p>
          <p class="site-footer__descriptor">{site.descriptor}</p>
        </div>
        <p class="site-footer__meta">© {currentYear}</p>
      </div>
    </footer>
  </body>
</html>
