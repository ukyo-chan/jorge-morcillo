---
import SiteNavigation from '../components/SiteNavigation.astro';
import type { StructuredData } from '../lib/seo';
import { site } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article' | 'book';
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
  structuredData?: StructuredData | StructuredData[];
}

const {
  title,
  description,
  ogType = 'website',
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  noindex,
  structuredData
} = Astro.props;

const shouldNoindex = noindex ?? !site.indexingEnabled;
const pageTitle = title === site.name ? `${site.name} | Escritor valenciano` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
const socialImagePath = image ?? site.defaultSocialImage;
const socialImage = new URL(socialImagePath, Astro.site ?? site.url).toString();
const socialImageAlt = imageAlt ?? `Retrato editorial de ${site.name}`;
const currentYear = new Date().getFullYear();
const structuredDataItems = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const serializedStructuredData = structuredDataItems.map((item) =>
  JSON.stringify(item).replace(/</g, '\\u003c')
);
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={shouldNoindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#f5f1e8" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={site.faviconLight} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href={site.faviconDark} media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href={site.faviconLight} />
    <title>{pageTitle}</title>

    {serializedStructuredData.map((json) => (
      <script type="application/ld+json" set:html={json}></script>
    ))}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href="/" aria-label={`${site.name}, inicio`}>
          <img
            class="site-brand__mark"
            src={site.brandLogo}
            alt=""
            width="54"
            height="54"
            loading="eager"
            decoding="async"
          />
          <span class="site-brand__text">
            <span class="site-brand__name">{site.name}</span>
            <span class="site-brand__descriptor">{site.shortDescriptor}</span>
          </span>
        </a>
        <SiteNavigation />
      </div>
    </header>

    <main class="site-main" id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__brand">
          <img
            class="site-footer__mark"
            src={site.brandLogo}
            alt=""
            width="46"
            height="46"
            loading="lazy"
            decoding="async"
          />
          <div>
            <p class="site-footer__name">{site.name}</p>
            <p class="site-footer__descriptor">{site.descriptor}</p>
          </div>
        </div>
        <div class="site-footer__meta">
          <a
            class="site-footer__social"
            href={site.instagramUrl}
            target="_blank"
            rel="me noopener noreferrer"
          >
            Instagram {site.instagramHandle}
          </a>
          <span>© {currentYear}</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-brand {
    align-items: center;
    flex-direction: row;
    gap: 0.85rem;
  }

  .site-brand__mark {
    width: 54px;
    height: 54px;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .site-brand__text {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }

  .site-footer__mark {
    width: 46px;
    height: 46px;
    flex: 0 0 auto;
    object-fit: contain;
  }

  @media (max-width: 620px) {
    .site-brand {
      gap: 0.65rem;
    }

    .site-brand__mark {
      width: 46px;
      height: 46px;
    }
  }
</style>
