---
interface CoverImage {
  src: string;
  alt: string;
  pie?: string;
  credito?: string;
  width?: number;
  height?: number;
}

interface Props {
  image: CoverImage;
  loading?: 'eager' | 'lazy';
  priority?: boolean;
  galleryTarget?: string;
  galleryLabel?: string;
}

const { image, loading = 'lazy', priority = false, galleryTarget, galleryLabel = 'Ver imágenes del interior' } = Astro.props;
---

<figure class="book-cover">
  <div class="book-cover__frame">
    {galleryTarget ? (
      <button
        type="button"
        class="book-cover__gallery-trigger"
        data-gallery-open={galleryTarget}
        data-gallery-index="0"
        aria-label={galleryLabel}
      >
        <img
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading={loading}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding="async"
        />
        <span class="book-cover__gallery-hint" aria-hidden="true">Ver interior</span>
      </button>
    ) : (
      <img
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading={loading}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    )}
  </div>
  {(image.pie || image.credito) && (
    <figcaption>
      {image.pie && <span>{image.pie}</span>}
      {image.credito && <span>{image.credito}</span>}
    </figcaption>
  )}
</figure>
